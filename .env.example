# Google Gemini API key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot (Create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram Chat ID (Get from @userinfobot on Telegram)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Minimum score to send a Telegram alert (0 - 100)
MIN_ALERT_SCORE=70
